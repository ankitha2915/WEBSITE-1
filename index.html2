<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Royal Palace Hotel - Menu</title>

  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: Georgia, serif;
      background: #f8f3e8;
      color: #333;
    }

    header {
      background: #4b1f1f;
      color: #fff;
      text-align: center;
      padding: 35px 20px;
    }

    header h1 {
      font-size: 40px;
      color: #f4c95d;
    }

    header p {
      margin-top: 8px;
      font-size: 18px;
    }

    nav {
      background: #2f1515;
      text-align: center;
      padding: 15px;
      position: sticky;
      top: 0;
      z-index: 10;
    }

    nav a {
      color: white;
      text-decoration: none;
      margin: 0 15px;
      font-weight: bold;
    }

    nav a:hover {
      color: #f4c95d;
    }

    .menu {
      max-width: 1000px;
      margin: 40px auto;
      padding: 0 20px;
    }

    .category {
      margin-bottom: 45px;
    }

    .category h2 {
      text-align: center;
      color: #8b4513;
      font-size: 30px;
      margin-bottom: 20px;
      border-bottom: 2px solid #d6ad45;
      padding-bottom: 10px;
    }

    .items {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 20px;
    }

    .item {
      background: white;
      padding: 20px;
      border-radius: 10px;
      border-left: 5px solid #d6ad45;
      box-shadow: 0 3px 10px rgba(0,0,0,0.1);
      transition: 0.3s;
    }

    .item:hover {
      transform: translateY(-5px);
      box-shadow: 0 7px 15px rgba(0,0,0,0.15);
    }

    .item-header {
      display: flex;
      justify-content: space-between;
      gap: 15px;
    }

    .item h3 {
      color: #4b1f1f;
      font-size: 20px;
    }

    .price {
      color: #b8860b;
      font-weight: bold;
      white-space: nowrap;
    }

    .item p {
      margin-top: 8px;
      color: #666;
      line-height: 1.5;
      font-family: Arial, sans-serif;
      font-size: 14px;
    }

    footer {
      background: #4b1f1f;
      color: white;
      text-align: center;
      padding: 25px;
      margin-top: 40px;
    }

    footer span {
      color: #f4c95d;
    }

    @media (max-width: 600px) {
      header h1 {
        font-size: 30px;
      }

      nav a {
        margin: 0 6px;
        font-size: 14px;
      }

      .category h2 {
        font-size: 25px;
      }
    }
  </style>
</head>

<body>

  <header>
    <h1>🏨 Royal Palace Hotel</h1>
    <p>Fine Dining • Great Taste • Warm Hospitality</p>
  </header>

  <nav>
    <a href="#breakfast">Breakfast</a>
    <a href="#starters">Starters</a>
    <a href="#main">Main Course</a>
    <a href="#desserts">Desserts</a>
    <a href="#drinks">Drinks</a>
  </nav>

  <main class="menu">

    <!-- Breakfast -->
    <section class="category" id="breakfast">
      <h2>🍳 Breakfast</h2>

      <div class="items">
        <div class="item">
          <div class="item-header">
            <h3>Masala Dosa</h3>
            <span class="price">₹120</span>
          </div>
          <p>Crispy dosa served with potato masala, sambar and chutney.</p>
        </div>

        <div class="item">
          <div class="item-header">
            <h3>Idli Sambar</h3>
            <span class="price">₹90</span>
          </div>
          <p>Soft steamed idlis served with hot sambar and coconut chutney.</p>
        </div>

        <div class="item">
          <div class="item-header">
            <h3>Veg Sandwich</h3>
            <span class="price">₹150</span>
          </div>
          <p>Fresh vegetables, cheese and herbs grilled to perfection.</p>
        </div>
      </div>
    </section>

    <!-- Starters -->
    <section class="category" id="starters">
      <h2>🥗 Starters</h2>

      <div class="items">
        <div class="item">
          <div class="item-header">
            <h3>Paneer Tikka</h3>
            <span class="price">₹220</span>
          </div>
          <p>Marinated paneer grilled with onions and colorful peppers.</p>
        </div>

        <div class="item">
          <div class="item-header">
            <h3>Veg Spring Rolls</h3>
            <span class="price">₹180</span>
          </div>
          <p>Crispy rolls filled with fresh vegetables.</p>
        </div>

        <div class="item">
          <div class="item-header">
            <h3>Chicken Tikka</h3>
            <span class="price">₹280</span>
          </div>
          <p>Tender chicken marinated in aromatic Indian spices.</p>
        </div>
      </div>
    </section>

    <!-- Main Course -->
    <section class="category" id="main">
      <h2>🍛 Main Course</h2>

      <div class="items">
        <div class="item">
          <div class="item-header">
            <h3>Paneer Butter Masala</h3>
            <span class="price">₹260</span>
          </div>
          <p>Paneer cooked in a creamy tomato and butter gravy.</p>
        </div>

        <div class="item">
          <div class="item-header">
            <h3>Veg Biryani</h3>
            <span class="price">₹240</span>
          </div>
          <p>Fragrant basmati rice cooked with vegetables and spices.</p>
        </div>

        <div class="item">
          <div class="item-header">
            <h3>Chicken Biryani</h3>
            <span class="price">₹320</span>
          </div>
          <p>Aromatic basmati rice layered with tender spiced chicken.</p>
        </div>

        <div class="item">
          <div class="item-header">
            <h3>Dal Tadka</h3>
            <span class="price">₹180</span>
          </div>
          <p>Yellow lentils tempered with garlic, cumin and spices.</p>
        </div>
      </div>
    </section>

    <!-- Desserts -->
    <section class="category" id="desserts">
      <h2>🍰 Desserts</h2>

      <div class="items">
        <div class="item">
          <div class="item-header">
            <h3>Gulab Jamun</h3>
            <span class="price">₹100</span>
          </div>
          <p>Soft milk-solid dumplings served warm with sugar syrup.</p>
        </div>

        <div class="item">
          <div class="item-header">
            <h3>Chocolate Cake</h3>
            <span class="price">₹160</span>
          </div>
          <p>Rich and moist chocolate cake with chocolate cream.</p>
        </div>

        <div class="item">
          <div class="item-header">
            <h3>Ice Cream</h3>
            <span class="price">₹120</span>
          </div>
          <p>Choose from vanilla, chocolate or strawberry.</p>
        </div>
      </div>
    </section>

    <!-- Drinks -->
    <section class="category" id="drinks">
      <h2>🥤 Drinks</h2>

      <div class="items">
        <div class="item">
          <div class="item-header">
            <h3>Fresh Lime Soda</h3>
            <span class="price">₹80</span>
          </div>
          <p>Refreshing lime soda served chilled.</p>
        </div>

        <div class="item">
          <div class="item-header">
            <h3>Mango Shake</h3>
            <span class="price">₹140</span>
          </div>
          <p>Creamy shake made with fresh mangoes.</p>
        </div>

        <div class="item">
          <div class="item-header">
            <h3>Fresh Orange Juice</h3>
            <span class="price">₹120</span>
          </div>
          <p>Freshly squeezed orange juice.</p>
        </div>
      </div>
    </section>

  </main>

  <footer>
    <p>© 2026 <span>Royal Palace Hotel</span></p>
    <p>Thank you for dining with us!</p>
  </footer>

</body>
</html>
